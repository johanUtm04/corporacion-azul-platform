{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/caz/wordpress-content-model/v0.2",
  "title": "CAZ WordPress content model — V1 / V2 migration blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brands",
    "categories",
    "regions",
    "legal_entities",
    "products",
    "branches"
  ],
  "properties": {
    "brands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/brand"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "legal_entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legal_entity"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/branch"
      }
    }
  },
  "$defs": {
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_id",
        "slug",
        "name"
      ],
      "properties": {
        "public_id": {
          "type": "string",
          "format": "uuid"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "logo_media_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "website_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_id",
        "slug",
        "name",
        "parent_category_ref"
      ],
      "properties": {
        "public_id": {
          "type": "string",
          "format": "uuid"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_category_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_id",
        "slug",
        "name"
      ],
      "properties": {
        "public_id": {
          "type": "string",
          "format": "uuid"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "legal_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_id",
        "slug",
        "legal_name",
        "status"
      ],
      "properties": {
        "public_id": {
          "type": "string",
          "format": "uuid"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "legal_name": {
          "type": "string",
          "minLength": 1
        },
        "short_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "publish"
          ]
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_id",
        "slug",
        "name",
        "status",
        "brand_ref",
        "category_refs",
        "show_price",
        "price_amount",
        "price_currency",
        "show_availability",
        "availability_note"
      ],
      "properties": {
        "public_id": {
          "type": "string",
          "format": "uuid"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "publish"
          ]
        },
        "short_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "presentation": {
          "type": [
            "string",
            "null"
          ]
        },
        "brand_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "category_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "featured_image_media_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "gallery_media_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "technical_pdf_media_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "show_price": {
          "type": "boolean"
        },
        "price_amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "price_currency": {
          "type": "string",
          "enum": [
            "MXN"
          ]
        },
        "show_availability": {
          "type": "boolean"
        },
        "availability_note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "show_price": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "price_amount": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "show_availability": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "availability_note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "publish"
              }
            }
          },
          "then": {
            "properties": {
              "brand_ref": {
                "type": "string",
                "format": "uuid"
              },
              "category_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_id",
        "slug",
        "name",
        "status",
        "city",
        "state",
        "address",
        "region_ref",
        "operating_entity_ref",
        "fiscal_entity_ref"
      ],
      "properties": {
        "public_id": {
          "type": "string",
          "format": "uuid"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "publish"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "postal_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "whatsapp": {
          "type": [
            "string",
            "null"
          ]
        },
        "opening_hours": {
          "type": [
            "string",
            "null"
          ]
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "maps_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "region_ref": {
          "type": "string",
          "format": "uuid"
        },
        "operating_entity_ref": {
          "type": "string",
          "format": "uuid"
        },
        "fiscal_entity_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "publish"
              }
            }
          },
          "then": {
            "properties": {
              "address": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
